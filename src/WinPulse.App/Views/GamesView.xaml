<UserControl x:Class="WinPulse.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinPulse.App.ViewModels"
             xmlns:c="clr-namespace:WinPulse.App.Controls"
             xmlns:i="clr-namespace:WinPulse.App.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PickerItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="LevelDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="{StaticResource Good}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="info">
                    <Setter Property="Fill" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="warn">
                    <Setter Property="Fill" Value="{StaticResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="bad">
                    <Setter Property="Fill" Value="{StaticResource Bad}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,30">
            <TextBlock Text="FPS-лаборатория" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,20" MaxWidth="900" HorizontalAlignment="Left"
                       Text="Замер FPS и 1% low в любой игре — с выводом, во что она упирается. А пока вы играете, WinPulse сам записывает сессию и потом показывает, что мешало игре и в какие моменты."/>

            <!-- Замер -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Замер FPS" Style="{StaticResource H2}"/>
                        <TextBlock Text="ИГРА" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target, Mode=TwoWay}"
                                 MaxHeight="190" IsEnabled="{Binding IsMeasuring, Converter={StaticResource Not}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GameTargetVm}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Exe}" Style="{StaticResource FaintText}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource FaintText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="2,6,0,0"
                                   Text="Запустите игру — она появится в списке сама (по папке установки или нагрузке на видеокарту)."
                                   Visibility="{Binding Targets.Count, Converter={StaticResource ZeroToVis}}"/>

                        <TextBlock Text="ДЛИТЕЛЬНОСТЬ" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                        <Border Background="{StaticResource PanelAlt}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="dur" Content="30 с" IsChecked="{Binding Is30, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="dur" Content="1 мин" IsChecked="{Binding Is60, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="dur" Content="2 мин" IsChecked="{Binding Is120, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="dur" Content="5 мин" IsChecked="{Binding Is300, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,18,0,0">
                            <Button Style="{StaticResource BtnPrimary}" Command="{Binding StartCommand}" Margin="0,0,10,6" Padding="18,9"
                                    Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVisInv}}">
                                <TextBlock Text="Начать замер" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource Btn}" Command="{Binding StopCommand}" Margin="0,0,10,6" Padding="18,9"
                                    Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Остановить" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource Btn}" Command="{Binding DownloadCommand}" Margin="0,0,10,6"
                                    Visibility="{Binding HasTool, Converter={StaticResource BoolToVisInv}}" Content="Скачать PresentMon"/>
                            <Button Style="{StaticResource BtnGhost}" Command="{Binding OpenCapturesCommand}" Margin="0,0,0,6" Content="Папка с замерами"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ToolText}" Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                   Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Живой FPS и результат -->
                <Border Grid.Column="2" Style="{StaticResource FeatureCard}" Effect="{StaticResource GlowViolet}"/>
                <Border Grid.Column="2" Style="{StaticResource FeatureCard}" Background="Transparent" BorderBrush="Transparent">
                    <Grid>
                        <!-- Идёт замер -->
                        <StackPanel Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ИДЁТ ЗАМЕР" Style="{StaticResource Caption}" Foreground="#C4B5FD"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding LiveFpsText}" Style="{StaticResource BigNumber}" FontSize="72" Effect="{StaticResource GlowViolet}"/>
                                <TextBlock Text="FPS" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="10,0,0,14"/>
                            </StackPanel>
                            <ProgressBar Height="6" Margin="0,14,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                         Foreground="{StaticResource AccentGradient}" Background="{StaticResource Track}" BorderThickness="0"/>
                            <TextBlock Text="Переключитесь в игру и играйте как обычно. Итог появится здесь." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
                        </StackPanel>

                        <!-- Результат -->
                        <StackPanel>
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{x:Static i:AllTrueToVisibility.Instance}">
                                    <Binding Path="HasResult"/>
                                    <Binding Path="IsMeasuring" Converter="{StaticResource Not}"/>
                                </MultiBinding>
                            </StackPanel.Visibility>
                            <TextBlock Text="ПОСЛЕДНИЙ ЗАМЕР" Style="{StaticResource Caption}" Foreground="#C4B5FD"/>
                            <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding AvgText}" Style="{StaticResource BigNumber}" FontSize="64"/>
                                <TextBlock Text="FPS в среднем" FontSize="15" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="10,0,0,12"/>
                            </StackPanel>
                            <UniformGrid Columns="3" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Low1Text}" Style="{StaticResource BigNumber}" FontSize="22"/>
                                    <TextBlock Text="1% low" Style="{StaticResource FaintText}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Low01Text}" Style="{StaticResource BigNumber}" FontSize="22"/>
                                    <TextBlock Text="0,1% low" Style="{StaticResource FaintText}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding FrameTimeText}" Style="{StaticResource BigNumber}" FontSize="22"/>
                                    <TextBlock Text="время кадра" Style="{StaticResource FaintText}"/>
                                </StackPanel>
                            </UniformGrid>
                            <c:AreaChart Height="70" Margin="0,14,0,0" Values="{Binding ResultChart}" Stroke="{StaticResource Violet}" FillOpacity="0.2" MinimumScale="30"/>
                            <TextBlock Text="{Binding StutterText}" Style="{StaticResource FaintText}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding BottleneckText}" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding BottleneckAdvice}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding CompareText}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding CompareText, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>

                        <!-- Пока ничего -->
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{x:Static i:AllTrueToVisibility.Instance}">
                                    <Binding Path="HasResult" Converter="{StaticResource Not}"/>
                                    <Binding Path="IsMeasuring" Converter="{StaticResource Not}"/>
                                </MultiBinding>
                            </StackPanel.Visibility>
                            <TextBlock Text="—" Style="{StaticResource BigNumber}" FontSize="64" Foreground="{StaticResource Faint}"/>
                            <TextBlock Text="Выберите игру и нажмите «Начать замер». Итог покажет средний FPS, 1% low и во что упирается игра: в видеокарту, процессор или ограничитель кадров."
                                       Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- История замеров -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding History.Count, Converter={StaticResource ZeroToVisInv}}">
                <StackPanel>
                    <TextBlock Text="История замеров" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <Grid Margin="10,0,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ИГРА" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="1" Text="КОГДА" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="2" Text="СРЕДНИЙ FPS" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="1% LOW" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="К ПРОШЛОМУ" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MeasurementVm}">
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource FaintText}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding AvgText}" FontFamily="{StaticResource DisplayFont}" FontSize="15" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LowText}" FontFamily="{StaticResource DisplayFont}" FontSize="15" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="{Binding ChangeText}" HorizontalAlignment="Right" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChangeLevel}" Value="good">
                                                            <Setter Property="Foreground" Value="{StaticResource Good}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChangeLevel}" Value="bad">
                                                            <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Игровые сессии -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Игровые сессии" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Faint}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SessionActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                            <Setter Property="Effect" Value="{StaticResource GlowCyan}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding SessionText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource FaintText}" TextWrapping="Wrap"
                               Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisInv}}"
                               Text="Записей пока нет. Поиграйте хотя бы минуту — после выхода из игры здесь появится разбор: во что упиралась игра, какие программы отнимали ресурсы и что происходило, когда проседали кадры."/>

                    <Grid Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                 MaxHeight="520" VerticalAlignment="Top">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SessionItemVm}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Style="{StaticResource LevelDot}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource FaintText}">
                                                <Run Text="{Binding DateText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DurationText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Headline}" Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding ReportSummary}" Style="{StaticResource MutedText}"/>
                            <Grid Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,0,0">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource Series.Cpu}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Процессор" Style="{StaticResource FaintText}" Margin="0,0,14,0"/>
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource Series.Gpu}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Видеокарта" Style="{StaticResource FaintText}"/>
                                </StackPanel>
                                <c:AreaChart Height="110" Margin="0,18,0,0" Values="{Binding ReportCpu}" Values2="{Binding ReportGpu}" Maximum="100"
                                             Stroke="{StaticResource Series.Cpu}" Stroke2="{StaticResource Series.Gpu}" ShowGrid="True" GridBrush="{StaticResource Line}"/>
                            </Grid>
                            <StackPanel Visibility="{Binding HasReportFps, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                <TextBlock Text="FPS (когда шёл замер)" Style="{StaticResource FaintText}"/>
                                <c:AreaChart Height="60" Margin="0,4,0,0" Values="{Binding ReportFps}" Stroke="{StaticResource Violet}" MinimumScale="30"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Findings}" Margin="0,14,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Style="{StaticResource LevelDot}" VerticalAlignment="Top" Margin="2,5,12,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding Interferers.Count, Converter={StaticResource ZeroToVisInv}}" Margin="0,4,0,0">
                                <TextBlock Text="КТО ОТНИМАЛ РЕСУРСЫ У ИГРЫ (В СРЕДНЕМ ЗА СЕССИЮ)" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Interferers}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:InterfererVm}">
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource FaintText}">
                                                            <Run Text="ЦП "/><Run Text="{Binding CpuText, Mode=OneWay}" Foreground="{StaticResource Series.Cpu}"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource FaintText}">
                                                            <Run Text="ГП "/><Run Text="{Binding GpuText, Mode=OneWay}" Foreground="{StaticResource Series.Gpu}"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource FaintText}">
                                                            <Run Text="диск "/><Run Text="{Binding IoText, Mode=OneWay}" Foreground="{StaticResource Series.Disk}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Advice}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                                               Visibility="{Binding Advice, Converter={StaticResource NullToVis}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding Moments.Count, Converter={StaticResource ZeroToVisInv}}" Margin="0,14,0,0">
                                <TextBlock Text="ЗАМЕТНЫЕ МОМЕНТЫ" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Moments}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MomentVm}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource Accent}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
