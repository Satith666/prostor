<UserControl x:Class="WinPulse.App.Views.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:WinPulse.App.Infrastructure"
             xmlns:vm="clr-namespace:WinPulse.App.ViewModels"
             xmlns:v="clr-namespace:WinPulse.App.Views"
             xmlns:c="clr-namespace:WinPulse.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">
            <TextBlock Text="{i:L 'Диски', 'Disks'}" Style="{StaticResource H1}"/>
            <TextBlock Text="{i:L 'Главный показатель — время ответа. Загрузка 100% при быстром ответе — нормальная работа.', 'Response time is what matters. 100% active with fast responses is normal work.'}"
                       Style="{StaticResource FaintText}" Margin="0,4,0,18" TextWrapping="Wrap"/>

            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiskCardVm}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                                        <TextBlock Text="{Binding Type}" Style="{StaticResource FaintText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Active}" Style="{StaticResource Big}" HorizontalAlignment="Right" ToolTip="{i:L 'Доля времени, когда диск был занят', 'Share of time the disk was busy'}"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{i:L 'АКТИВНОСТЬ ЗА 10 МИНУТ, %', 'ACTIVITY, LAST 10 MINUTES, %'}" Style="{StaticResource Caption}"/>
                                        <c:AreaChart Height="110" Margin="0,8,0,10" Values="{Binding ActiveChart}" Capacity="600" Maximum="100"
                                                     ShowGrid="True" GridBrush="{StaticResource Line}" Stroke="{StaticResource Series.Disk}"/>
                                        <TextBlock Text="{i:L 'ЧТЕНИЕ И ЗАПИСЬ ЗА 2 МИНУТЫ', 'READ AND WRITE, LAST 2 MINUTES'}" Style="{StaticResource Caption}"/>
                                        <c:AreaChart Height="70" Margin="0,8,0,0" Values="{Binding ReadChart}" Values2="{Binding WriteChart}" Capacity="120"
                                                     MinimumScale="1048576" Stroke="{StaticResource Series.Disk}" Stroke2="{StaticResource Series.Disk2}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Grid Margin="0,0,0,10" ToolTip="{i:L 'Сколько в среднем диск отвечает на один запрос. SSD — доли миллисекунды, HDD — 5–20 мс.', 'Average time the disk takes to answer one request. SSD: under a millisecond, HDD: 5–20 ms.'}">
                                            <TextBlock Text="{i:L 'Время ответа', 'Response time'}" Style="{StaticResource FaintText}"/>
                                            <TextBlock Text="{Binding Latency}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="{i:L 'Чтение', 'Read'}" Foreground="{StaticResource Series.Disk}" FontSize="12"/>
                                            <TextBlock Text="{Binding Read}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="{i:L 'Запись', 'Write'}" Foreground="{StaticResource Series.Disk2}" FontSize="12"/>
                                            <TextBlock Text="{Binding Write}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,14" ToolTip="{i:L 'Сколько запросов ждут своей очереди прямо сейчас.', 'How many requests are waiting right now.'}">
                                            <TextBlock Text="{i:L 'Очередь', 'Queue'}" Style="{StaticResource FaintText}"/>
                                            <TextBlock Text="{Binding Queue}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Volumes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:VolumeVm}">
                                                    <StackPanel Margin="0,0,0,10">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <c:FractionBar x:Name="bar" Height="6" Margin="0,5,0,4" Value="{Binding Fraction}"
                                                                       Fill="{StaticResource Accent}" Track="{StaticResource Track}"/>
                                                        <TextBlock Text="{Binding Text}" Style="{StaticResource FaintText}"/>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Low}" Value="True">
                                                            <Setter TargetName="bar" Property="Fill" Value="{StaticResource Bad}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding Verdict, Converter={StaticResource NullToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding VerdictDetail}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{i:L 'Кто читает и пишет', 'Who reads and writes'}" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <v:AppTable DataContext="{Binding Table}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
