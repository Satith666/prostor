<UserControl x:Class="WinPulse.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinPulse.App.ViewModels"
             xmlns:i="clr-namespace:WinPulse.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Text="Автозагрузка" Style="{StaticResource H1}"/>
            <TextBlock Text="Программы, которые запускаются вместе с Windows: из реестра, папок «Автозагрузка» и Планировщика заданий. Отключение работает как в Диспетчере задач — запись остаётся на месте, её можно включить обратно в любой момент."
                       Style="{StaticResource MutedText}" Margin="0,6,0,18"/>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource H2}" FontSize="17"/>
                        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                   Visibility="{Binding MemoryText, Converter={StaticResource NullToVis}}"/>
                        <TextBlock Text="{Binding BackupText}" Style="{StaticResource FaintText}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource Accent}" Margin="0,8,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Style="{StaticResource BtnPrimary}" Padding="16,8" Command="{Binding DisableRecommendedCommand}">
                            <TextBlock Text="{Binding DisableRecommendedText}"/>
                        </Button>
                        <Button Style="{StaticResource Btn}" Margin="0,8,0,0" Command="{Binding RevertAllCommand}" Content="Вернуть всё как было"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Style="{StaticResource BtnGhost}" Command="{Binding RefreshCommand}" Content="Обновить"/>
                            <Button Style="{StaticResource BtnGhost}" Command="{Binding OpenTaskManagerCommand}" Content="Диспетчер задач"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StartupRowVm}">
                        <Border x:Name="row" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="9" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="24" Height="24" Margin="0,2,12,0" VerticalAlignment="Top">
                                    <Image Source="{Binding Icon}" Width="20" Height="20"
                                           Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"/>
                                    <Viewbox Width="18" Height="18" Visibility="{Binding Icon, Converter={StaticResource NullToVisInv}}">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource Icon.App}" Stroke="{StaticResource Faint}" StrokeThickness="1.8"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="name" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource FaintText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                        <Run Text="{Binding Publisher, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding Source, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding AdviceTip}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource Mono}" Margin="0,4,0,0"
                                               Visibility="{Binding ProMode, Source={x:Static i:UiState.I}, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <Border x:Name="chip" Grid.Column="2" Style="{StaticResource Chip}" Margin="12,0,12,0" VerticalAlignment="Top">
                                    <TextBlock x:Name="chipText" Text="{Binding AdviceText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                </Border>

                                <StackPanel Grid.Column="3" VerticalAlignment="Top">
                                    <TextBlock x:Name="status" Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{StaticResource Good}"/>
                                    <TextBlock Text="{Binding MemoryText}" Style="{StaticResource FaintText}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" VerticalAlignment="Top">
                                    <Button Style="{StaticResource Btn}" Padding="12,5" MinWidth="100" Command="{Binding ToggleCommand}" Content="{Binding ToggleLabel}"/>
                                    <Button Style="{StaticResource BtnGhost}" Padding="4,2" Margin="0,4,0,0" HorizontalAlignment="Center"
                                            Command="{Binding OpenFolderCommand}" Content="Папка" FontSize="12"/>
                                    <TextBlock Text="нужны права администратора" Style="{StaticResource FaintText}" FontSize="10" HorizontalAlignment="Center"
                                               Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter TargetName="status" Property="Foreground" Value="{StaticResource Faint}"/>
                                <Setter TargetName="name" Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter TargetName="row" Property="Opacity" Value="0.8"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AdviceKey}" Value="disable">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource GoodBg}"/>
                                <Setter TargetName="chipText" Property="Foreground" Value="{StaticResource Good}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AdviceKey}" Value="keep">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource WarnBg}"/>
                                <Setter TargetName="chipText" Property="Foreground" Value="{StaticResource Warn}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Службы и системные задания Windows здесь не показываются и не меняются. Программы, которые сами добавляют себя в автозагрузку при каждом запуске, лучше отключать в их собственных настройках."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
