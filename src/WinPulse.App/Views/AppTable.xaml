<UserControl x:Class="WinPulse.App.Views.AppTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinPulse.App.ViewModels"
             xmlns:c="clr-namespace:WinPulse.App.Controls"
             xmlns:i="clr-namespace:WinPulse.App.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="CpuCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CpuHot}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MemCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MemHot}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DiskCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DiskHot}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GpuCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding GpuHot}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource HeaderBtn}">
            <Setter Property="Command" Value="{Binding SortCommand}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Заголовки столбцов -->
        <Grid Margin="8,0,8,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="76"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" CommandParameter="name" HorizontalContentAlignment="Left">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SortHeader}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SortName}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{i:L 'ПРИЛОЖЕНИЕ', 'APP'}"/>
            </Button>
            <Button Grid.Column="2" CommandParameter="cpu">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SortHeader}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SortCpu}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{i:L 'ПРОЦЕССОР', 'CPU'}"/>
            </Button>
            <Button Grid.Column="3" CommandParameter="memory">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SortHeader}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SortMemory}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{i:L 'ПАМЯТЬ', 'MEMORY'}"/>
            </Button>
            <Button Grid.Column="4" CommandParameter="disk">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SortHeader}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SortDisk}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{i:L 'ДИСК', 'DISK'}"/>
            </Button>
            <Button Grid.Column="5" CommandParameter="gpu">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SortHeader}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SortGpu}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{i:L 'ВИДЕО', 'GPU'}"/>
            </Button>
        </Grid>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,4"/>

        <!-- Строки -->
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AppRowVm}">
                    <Border x:Name="row" Background="Transparent" CornerRadius="7" Padding="8,6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton Style="{StaticResource Chevron}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" VerticalAlignment="Center"/>

                                <Grid Grid.Column="1" Background="Transparent" Cursor="Hand" ToolTip="{Binding Hint}">
                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}"/>
                                    </Grid.InputBindings>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="18" Height="18"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"/>
                                        <Viewbox Width="16" Height="16" Visibility="{Binding Icon, Converter={StaticResource NullToVisInv}}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource Icon.App}" Stroke="{StaticResource Faint}" StrokeThickness="1.8"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                            <Border Style="{StaticResource Chip}" Background="{StaticResource WarnBg}" Padding="6,0" Margin="8,0,0,0"
                                                    Visibility="{Binding Badge, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Warn}" FontSize="11"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource FaintText}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Kind, Mode=OneWay}"/>
                                            <Run Text="{Binding Publisher, Mode=OneWay}"/>
                                            <Run Text="{Binding Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Cpu}" Style="{StaticResource CpuCell}"/>
                                    <c:FractionBar Height="3" Margin="0,4,0,0" Value="{Binding CpuBar}" Fill="{StaticResource Series.Cpu}" Track="{StaticResource Track}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Memory}" Style="{StaticResource MemCell}"/>
                                    <c:FractionBar Height="3" Margin="0,4,0,0" Value="{Binding MemBar}" Fill="{StaticResource Series.Memory}" Track="{StaticResource Track}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Disk}" Style="{StaticResource DiskCell}"/>
                                    <c:FractionBar Height="3" Margin="0,4,0,0" Value="{Binding DiskBar}" Fill="{StaticResource Series.Disk}" Track="{StaticResource Track}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Gpu}" Style="{StaticResource GpuCell}"/>
                                    <c:FractionBar Height="3" Margin="0,4,0,0" Value="{Binding GpuBar}" Fill="{StaticResource Series.Gpu}" Track="{StaticResource Track}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Раскрытая строка: процессы и действия -->
                            <StackPanel Margin="58,8,0,2" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Secondary}" Style="{StaticResource FaintText}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" Margin="0,0,0,6"
                                           Visibility="{Binding Path, Converter={StaticResource NullToVis}}"/>
                                <ItemsControl ItemsSource="{Binding Processes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProcessRowVm}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="76"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}"/>
                                                    <TextBlock Style="{StaticResource FaintText}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <Run Text="PID"/>
                                                        <Run Text="{Binding Pid, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource FaintText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding ProMode, Source={x:Static i:UiState.I}, Converter={StaticResource BoolToVis}}">
                                                        <Run Text="{i:L '· потоков', '· threads'}"/>
                                                        <Run Text="{Binding Threads, Mode=OneWay}"/>
                                                        <Run Text="{i:L '· дескрипторов', '· handles'}"/>
                                                        <Run Text="{Binding Handles, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource FaintText}" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Cpu}" Style="{StaticResource Cell}" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Memory}" Style="{StaticResource Cell}" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Disk}" Style="{StaticResource Cell}" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Gpu}" Style="{StaticResource Cell}" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource Btn}" Padding="10,4" Command="{Binding OpenFolderCommand}" Content="{i:L 'Открыть папку', 'Open folder'}"/>
                                    <Button Style="{StaticResource BtnDanger}" Padding="10,4" Margin="8,0,0,0" Command="{Binding EndCommand}"
                                            Content="{i:L 'Завершить', 'End task'}"
                                            Visibility="{Binding ProMode, Source={x:Static i:UiState.I}, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="8,6,0,0"
                Command="{Binding ToggleShowAllCommand}"
                Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ShowAllText}"/>
        </Button>
    </StackPanel>
</UserControl>
