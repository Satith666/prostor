<UserControl x:Class="WinPulse.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
                <Border Style="{StaticResource Chip}" Margin="12,4,0,0">
                    <TextBlock Text="{Binding Stage}" Foreground="{StaticResource Muted}" FontSize="12"/>
                </Border>
            </StackPanel>
            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,10,0,18"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Что будет" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Bullets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="•" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Text="Раздел появится в следующих версиях. Готово сейчас: мониторинг ресурсов, «Проблемы» и модуль «Игры в окне»."
                       Style="{StaticResource FaintText}" Margin="0,14,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
