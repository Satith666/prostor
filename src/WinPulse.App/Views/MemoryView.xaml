<UserControl x:Class="WinPulse.App.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinPulse.App.ViewModels"
             xmlns:v="clr-namespace:WinPulse.App.Views"
             xmlns:c="clr-namespace:WinPulse.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">
            <TextBlock Text="Память" Style="{StaticResource H1}"/>
            <TextBlock Text="Занятая память — не всегда проблема. Проблема — когда Windows начинает подгружать данные с диска."
                       Style="{StaticResource FaintText}" Margin="0,4,0,18" TextWrapping="Wrap"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="ИЗ ЧЕГО СОСТОИТ" Style="{StaticResource Caption}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding UsedPercent}" Style="{StaticResource Big}" Margin="0,-6,12,0"/>
                            <TextBlock Text="{Binding Used}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <c:StackBar Height="16" Margin="0,12,0,12" Segments="{Binding Segments}"/>
                    <ItemsControl ItemsSource="{Binding Legend}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LegendVm}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,22,6" Background="Transparent" ToolTip="{Binding Hint}">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" Margin="8,0,6,0"/>
                                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="ЗАНЯТО ЗА 10 МИНУТ, %" Style="{StaticResource Caption}"/>
                        <c:AreaChart Height="170" Margin="0,12,0,0" Values="{Binding Chart}" Capacity="600" Maximum="100"
                                     ShowGrid="True" GridBrush="{StaticResource Line}" Stroke="{StaticResource Series.Memory}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding Stats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatVm}">
                                <Grid Margin="0,0,0,12" Background="Transparent" ToolTip="{Binding Hint}">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource FaintText}"/>
                                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding Verdict, Converter={StaticResource NullToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding VerdictDetail}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Кто занимает память" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="Личная память процессов. Метка «растёт» — память увеличивается весь последний час: похоже на утечку."
                               Style="{StaticResource FaintText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <v:AppTable DataContext="{Binding Table}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
