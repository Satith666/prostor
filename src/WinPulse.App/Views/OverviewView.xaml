<UserControl x:Class="WinPulse.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinPulse.App.ViewModels"
             xmlns:v="clr-namespace:WinPulse.App.Views"
             xmlns:c="clr-namespace:WinPulse.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="14,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#343B47"/>
                                <Setter TargetName="bd" Property="Background" Value="#181C24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">
            <TextBlock Text="Обзор" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding SystemLine}" Style="{StaticResource FaintText}" Margin="0,4,0,18" TextTrimming="CharacterEllipsis"/>

            <!-- Плитки -->
            <ItemsControl ItemsSource="{Binding Kpis}" Margin="-6,0,-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:KpiVm}">
                        <Button Style="{StaticResource Tile}" Command="{Binding OpenCommand}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding Value}" Style="{StaticResource Big}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Sub}" Style="{StaticResource FaintText}" TextTrimming="CharacterEllipsis"/>
                                <c:AreaChart Height="38" Margin="0,10,0,0" Values="{Binding Spark}" Capacity="60"
                                             Maximum="{Binding SparkMax}" Stroke="{Binding Brush}" MinimumScale="1"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Главное сейчас -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Главное сейчас" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Verdicts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VerdictVm}">
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Margin="2,5,12,0" VerticalAlignment="Top">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Good}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="info">
                                                        <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="warn">
                                                        <Setter Property="Fill" Value="{StaticResource Warn}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="bad">
                                                        <Setter Property="Fill" Value="{StaticResource Bad}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Кто нагружает -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Кто нагружает" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource PanelAlt}" CornerRadius="8" Padding="2" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="metric" Content="Процессор" IsChecked="{Binding MetricCpu, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="metric" Content="Память" IsChecked="{Binding MetricMemory, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="metric" Content="Диск" IsChecked="{Binding MetricDisk, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="metric" Content="Видеокарта" IsChecked="{Binding MetricGpu, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <v:AppTable DataContext="{Binding Table}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
