<UserControl x:Class="WinPulse.App.Views.CpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:WinPulse.App.Infrastructure"
             xmlns:vm="clr-namespace:WinPulse.App.ViewModels"
             xmlns:v="clr-namespace:WinPulse.App.Views"
             xmlns:c="clr-namespace:WinPulse.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">
            <TextBlock Text="{i:L 'Процессор', 'Processor'}" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource FaintText}" Margin="0,4,0,18"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{i:L 'ЗАГРУЗКА ЗА 10 МИНУТ', 'LOAD, LAST 10 MINUTES'}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding Utility}" Style="{StaticResource Big}" HorizontalAlignment="Right" Margin="0,-6,0,0"/>
                        </Grid>
                        <c:AreaChart Height="200" Margin="0,12,0,0" Values="{Binding Chart}" Capacity="600" Maximum="100"
                                     ShowGrid="True" GridBrush="{StaticResource Line}" Stroke="{StaticResource Series.Cpu}"/>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{i:L '10 мин назад', '10 min ago'}" Style="{StaticResource FaintText}"/>
                            <TextBlock Text="{i:L 'сейчас', 'now'}" Style="{StaticResource FaintText}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding Stats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatVm}">
                                <Grid Margin="0,0,0,12" Background="Transparent" ToolTip="{Binding Hint}">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource FaintText}"/>
                                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding Verdict, Converter={StaticResource NullToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding VerdictDetail}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{i:L 'Кто нагружает процессор', 'What loads the CPU'}" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <v:AppTable DataContext="{Binding Table}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
