<UserControl x:Class="WinPulse.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinPulse.App.ViewModels"
             xmlns:i="clr-namespace:WinPulse.App.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="LevelDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="{StaticResource Good}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="info">
                    <Setter Property="Fill" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="warn">
                    <Setter Property="Fill" Value="{StaticResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="bad">
                    <Setter Property="Fill" Value="{StaticResource Bad}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Text="Драйверы" Style="{StaticResource H1}"/>
            <TextBlock Text="Версии и даты драйверов важных устройств. Ссылки ведут только на официальные сайты производителей и Центр обновления Windows. Сам WinPulse драйверы не скачивает и не устанавливает."
                       Style="{StaticResource MutedText}" Margin="0,6,0,18"/>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource H2}" FontSize="17"/>
                        <TextBlock Text="Проверяется возраст драйвера. Сравнение с последней версией на сайте производителя появится позже."
                                   Style="{StaticResource FaintText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Читаю драйверы…" Foreground="{StaticResource Accent}" Margin="0,8,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Style="{StaticResource BtnPrimary}" Padding="16,8" Command="{Binding OptionalUpdatesCommand}" Content="Необязательные обновления Windows"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Style="{StaticResource BtnGhost}" Command="{Binding RefreshCommand}" Content="Обновить"/>
                            <Button Style="{StaticResource BtnGhost}" Command="{Binding DeviceManagerCommand}" Content="Диспетчер устройств"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Видеодрайвер -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding GpuTitle, Converter={StaticResource NullToVis}}">
                <StackPanel>
                    <TextBlock Text="ВИДЕОДРАЙВЕР" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding GpuTitle}" Style="{StaticResource H2}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding GpuText}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Padding="0,4" Margin="0,8,0,0"
                            Command="{Binding ToggleStepsCommand}" Content="Как переустановить видеодрайвер начисто"/>
                    <ItemsControl ItemsSource="{Binding CleanSteps}" Visibility="{Binding ShowSteps, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Группы -->
            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DriverGroupVm}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DriverRowVm}">
                                            <Grid Margin="0,6,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Style="{StaticResource LevelDot}" VerticalAlignment="Top" Margin="0,6,12,0"/>
                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Style="{StaticResource FaintText}" Margin="0,2,0,0">
                                                        <Run Text="{Binding Vendor, Mode=OneWay}"/>
                                                        <Run Text="· драйвер от"/>
                                                        <Run Text="{Binding Provider, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Advice}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Technical}" Style="{StaticResource Mono}" Foreground="{StaticResource Faint}" Margin="0,4,0,0"
                                                               Visibility="{Binding ProMode, Source={x:Static i:UiState.I}, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Version}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Style="{StaticResource FaintText}">
                                                        <Run Text="{Binding DateText, Mode=OneWay}"/>
                                                        <Run Text="·"/>
                                                        <Run Text="{Binding AgeText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="3" Style="{StaticResource Btn}" Padding="10,4" VerticalAlignment="Top"
                                                        Command="{Binding OpenLinkCommand}" Content="{Binding LinkLabel}"
                                                        Visibility="{Binding LinkLabel, Converter={StaticResource NullToVis}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
