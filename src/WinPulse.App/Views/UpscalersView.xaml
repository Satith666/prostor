<UserControl x:Class="WinPulse.App.Views.UpscalersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinPulse.App.ViewModels"
             xmlns:i="clr-namespace:WinPulse.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,30">
            <TextBlock Text="{Binding [up.title], Source={x:Static i:Loc.I}}" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,20" MaxWidth="940" HorizontalAlignment="Left"
                       Text="{Binding [up.subtitle], Source={x:Static i:Loc.I}}" TextWrapping="Wrap"/>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding GpuText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource FaintText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding ScanCommand}" Margin="0,0,8,6" Content="{Binding [up.scan], Source={x:Static i:Loc.I}}"/>
                        <Button Style="{StaticResource Btn}" Command="{Binding OpenDlssSwapperCommand}" Margin="0,0,8,6" Content="DLSS Swapper"
                                ToolTip="{i:L 'Открытый инструмент для обновления DLSS, FSR и XeSS в играх (github.com/beeradmoore/dlss-swapper)', 'Open-source tool for updating DLSS, FSR and XeSS in games (github.com/beeradmoore/dlss-swapper)'}"/>
                        <Button Style="{StaticResource Btn}" Command="{Binding OpenOptiScalerCommand}" Margin="0,0,0,6" Content="OptiScaler"
                                ToolTip="{i:L 'Подмена апскейлера и генерация кадров FSR 3 (github.com/optiscaler/OptiScaler). Только для одиночных игр.', 'Upscaler substitution and FSR 3 frame generation (github.com/optiscaler/OptiScaler). Single-player games only.'}"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Games}" Margin="0,16,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:UpscaleGameVm}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource FaintText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Command="{Binding OpenFolderCommand}" Content="{Binding [up.folder], Source={x:Static i:Loc.I}}" VerticalAlignment="Top"/>
                                </Grid>

                                <WrapPanel Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding Badges}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="11" Padding="10,3" Margin="0,0,8,6" Background="{StaticResource AccentBg}"
                                                        BorderBrush="#5922D3EE" BorderThickness="1">
                                                    <TextBlock Text="{Binding}" Foreground="#A5F3FC" FontWeight="SemiBold" FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border CornerRadius="11" Padding="10,3" Margin="0,0,8,6" Background="{StaticResource WarnBg}" BorderBrush="#59FB923C" BorderThickness="1"
                                            Visibility="{Binding AntiCheat, Converter={StaticResource NullToVis}}">
                                        <TextBlock Foreground="{StaticResource Warn}" FontWeight="SemiBold" FontSize="12">
                                            <Run Text="{Binding [up.anticheat], Source={x:Static i:Loc.I}, Mode=OneWay}"/><Run Text="{Binding AntiCheat, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>

                                <ItemsControl ItemsSource="{Binding Advice}" Margin="0,4,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Top" Margin="2,7,0,0" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource MutedText}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="10,7" Margin="0,8,0,0">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{x:Static i:AllTrueToVisibility.Instance}">
                                            <Binding Path="ProMode" Source="{x:Static i:UiState.I}"/>
                                            <Binding Path="HasDlls"/>
                                        </MultiBinding>
                                    </Border.Visibility>
                                    <TextBlock Text="{Binding Technical}" Style="{StaticResource Mono}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
