<UserControl x:Class="WinPulse.App.Views.FixModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinPulse.App.ViewModels"
             xmlns:c="clr-namespace:WinPulse.App.Controls"
             xmlns:i="clr-namespace:WinPulse.App.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Danger}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,6,0,18"/>

            <!-- Игра -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding UsesGame, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding [wg.game], Source={x:Static i:Loc.I}}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="GameBox" Text="{Binding GameExe, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="{Binding [wg.game.placeholder], Source={x:Static i:Loc.I}}" Foreground="{StaticResource Faint}"
                                       Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=GameBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" Style="{StaticResource Btn}" Margin="8,0,0,0" Command="{Binding BrowseCommand}"
                                Content="{Binding [wg.browse], Source={x:Static i:Loc.I}}"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Margin="8,0,0,0" Command="{Binding PickRunningCommand}"
                                Content="{Binding [wg.running], Source={x:Static i:Loc.I}}"/>
                    </Grid>
                    <TextBlock Text="{Binding GameWarning}" Foreground="{StaticResource Warn}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding GameWarning, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Итог и общие кнопки -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource H2}" FontSize="17"/>
                        <c:FractionBar Height="6" Margin="0,10,0,10" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                       Value="{Binding Progress}" Fill="{StaticResource Good}" Track="{StaticResource Track}"/>
                        <TextBlock Text="{Binding SystemText}" Style="{StaticResource FaintText}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding BackupText}" Style="{StaticResource FaintText}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource BtnGhost}" Padding="6,0" Command="{Binding OpenBackupCommand}">
                                <TextBlock Text="{Binding [wg.backup], Source={x:Static i:Loc.I}}" FontSize="12"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource Accent}" Margin="0,8,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding FixAllCommand}" Padding="16,8"
                                Content="{Binding [wg.fixall], Source={x:Static i:Loc.I}}"/>
                        <Button Style="{StaticResource Btn}" Command="{Binding RevertAllCommand}" Margin="0,8,0,0"
                                Content="{Binding [wg.revertall], Source={x:Static i:Loc.I}}"/>
                        <Button Style="{StaticResource BtnGhost}" Command="{Binding RefreshCommand}" Margin="0,6,0,0" HorizontalAlignment="Center"
                                Content="{Binding [common.refresh], Source={x:Static i:Loc.I}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 13 пунктов -->
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FixItemVm}">
                        <Border x:Name="card" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="num" Width="30" Height="30" CornerRadius="15" Background="{StaticResource PanelAlt}"
                                        VerticalAlignment="Top" Margin="0,0,14,0">
                                    <TextBlock x:Name="numText" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <!-- Заголовок и статус -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border x:Name="chip" Grid.Column="1" Style="{StaticResource Chip}" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <TextBlock x:Name="chipText" Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding Reason, Converter={StaticResource NullToVis}}"/>
                                    <Border Background="{StaticResource WarnBg}" CornerRadius="7" Padding="10,7" Margin="0,8,0,0"
                                            Visibility="{Binding Warning, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Подпункты: программы, мониторы -->
                                    <ItemsControl ItemsSource="{Binding Entries}" Margin="0,10,0,0"
                                                  Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FixEntryVm}">
                                                <Border Background="{StaticResource PanelAlt}" CornerRadius="7" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock x:Name="entryTitle" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       Visibility="{Binding Detail, Converter={StaticResource NullToVis}}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                DataContext="{Binding Action}" Style="{StaticResource ActionButton}"
                                                                Content="{Binding Label}" Command="{Binding Command}"
                                                                Visibility="{Binding Converter={StaticResource NullToVis}}"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Warning}" Value="True">
                                                        <Setter TargetName="entryTitle" Property="Foreground" Value="{StaticResource Warn}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Инструкция -->
                                    <StackPanel Margin="0,8,0,0" Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Padding="0,2" Command="{Binding ToggleStepsCommand}">
                                            <TextBlock Text="{Binding [wg.steps], Source={x:Static i:Loc.I}}"/>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,4,0,0"
                                                      Visibility="{Binding ShowSteps, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Для профи -->
                                    <Border Background="{StaticResource Bg}" CornerRadius="7" Padding="10,7" Margin="0,10,0,0">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{x:Static i:AllTrueToVisibility.Instance}">
                                                <Binding Path="ProMode" Source="{x:Static i:UiState.I}"/>
                                                <Binding Path="Technical" Converter="{StaticResource NotNull}"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [wg.technical], Source={x:Static i:Loc.I}}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Technical}" Style="{StaticResource Mono}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Кнопки -->
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource BtnPrimary}" Margin="0,0,8,6" Command="{Binding FixCommand}"
                                                Content="{Binding FixLabel}"
                                                Visibility="{Binding CanFix, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource Btn}" Margin="0,0,8,6" Command="{Binding RevertCommand}"
                                                Content="{Binding [wg.revert], Source={x:Static i:Loc.I}}"/>
                                        <ItemsControl ItemsSource="{Binding Actions}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FixActionVm}">
                                                    <Button Style="{StaticResource ActionButton}" Margin="0,0,8,6" Content="{Binding Label}" Command="{Binding Command}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource Chip}" Background="{StaticResource WarnBg}" Margin="4,0,6,6"
                                                Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding [common.admin], Source={x:Static i:Loc.I}}" Foreground="{StaticResource Warn}" FontSize="11"/>
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Background="{StaticResource WarnBg}" Margin="0,0,6,6"
                                                Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding [common.restart], Source={x:Static i:Loc.I}}" Foreground="{StaticResource Yellow}" FontSize="11"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding StatusKey}" Value="ok">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource GoodBg}"/>
                                <Setter TargetName="chipText" Property="Foreground" Value="{StaticResource Good}"/>
                                <Setter TargetName="num" Property="Background" Value="{StaticResource GoodBg}"/>
                                <Setter TargetName="numText" Property="Foreground" Value="{StaticResource Good}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKey}" Value="improve">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource WarnBg}"/>
                                <Setter TargetName="chipText" Property="Foreground" Value="{StaticResource Warn}"/>
                                <Setter TargetName="card" Property="BorderBrush" Value="#4A3A22"/>
                                <Setter TargetName="numText" Property="Foreground" Value="{StaticResource Warn}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKey}" Value="na">
                                <Setter TargetName="chipText" Property="Foreground" Value="{StaticResource Faint}"/>
                                <Setter TargetName="card" Property="Opacity" Value="0.8"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="WinPulse не отключает Защитник и службы Windows, не трогает HPET, Win32PrioritySeparation, сетевые настройки, не чистит реестр и не ставит играм приоритет «Реального времени» — у этих «твиков» нет доказанного эффекта."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
