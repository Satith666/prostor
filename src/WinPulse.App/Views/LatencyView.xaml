<UserControl x:Class="WinPulse.App.Views.LatencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinPulse.App.ViewModels"
             xmlns:i="clr-namespace:WinPulse.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,30">
            <TextBlock Text="{Binding [lat.title], Source={x:Static i:Loc.I}}" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,20" MaxWidth="940" HorizontalAlignment="Left"
                       Text="{Binding [lat.subtitle], Source={x:Static i:Loc.I}}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.25*"/>
                </Grid.ColumnDefinitions>

                <!-- Запуск замера -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding [lat.measure], Source={x:Static i:Loc.I}}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding AdminText}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding [lat.duration], Source={x:Static i:Loc.I}, Converter={StaticResource Upper}}" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                        <Border Background="{StaticResource PanelAlt}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="lat" Content="{i:L '10 с', '10 s'}" IsChecked="{Binding Is10, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="lat" Content="{i:L '30 с', '30 s'}" IsChecked="{Binding Is30, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="lat" Content="{i:L '1 мин', '1 min'}" IsChecked="{Binding Is60, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,18,0,0">
                            <Button Style="{StaticResource BtnPrimary}" Command="{Binding MeasureCommand}" Margin="0,0,10,6" Padding="18,9">
                                <TextBlock Text="{Binding [lat.start], Source={x:Static i:Loc.I}}" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource BtnGhost}" Command="{Binding OpenLatencyMonCommand}" Margin="0,0,0,6" Content="LatencyMon"
                                    ToolTip="{i:L 'Бесплатная программа для подробного разбора задержек (resplendence.com)', 'Free tool for an in-depth latency breakdown (resplendence.com)'}"/>
                        </WrapPanel>
                        <ProgressBar Height="6" Margin="0,10,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                     Foreground="{StaticResource AccentGradient}" Background="{StaticResource Track}" BorderThickness="0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                   Visibility="{Binding Status, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Итог -->
                <Border Grid.Column="2" Style="{StaticResource FeatureCard}" Effect="{StaticResource GlowCyan}"/>
                <Border Grid.Column="2" Style="{StaticResource FeatureCard}" Background="Transparent" BorderBrush="Transparent">
                    <Grid>
                        <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVisInv}}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [lat.empty.title], Source={x:Static i:Loc.I}}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding [lat.empty.text], Source={x:Static i:Loc.I}}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding [lat.result], Source={x:Static i:Loc.I}, Converter={StaticResource Upper}}" Style="{StaticResource Caption}" Foreground="#A5F3FC"/>
                            <TextBlock Text="{Binding VerdictText}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding VerdictBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <UniformGrid Columns="4" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding MaxDpcText}" Style="{StaticResource Big}" FontSize="24"/>
                                    <TextBlock Text="{Binding [lat.maxdpc], Source={x:Static i:Loc.I}}" Style="{StaticResource FaintText}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding MaxIsrText}" Style="{StaticResource Big}" FontSize="24"/>
                                    <TextBlock Text="{Binding [lat.maxisr], Source={x:Static i:Loc.I}}" Style="{StaticResource FaintText}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding RateText}" Style="{StaticResource Big}" FontSize="24"/>
                                    <TextBlock Text="{Binding [lat.rate], Source={x:Static i:Loc.I}}" Style="{StaticResource FaintText}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding ShareText}" Style="{StaticResource Big}" FontSize="24"/>
                                    <TextBlock Text="{Binding [lat.share], Source={x:Static i:Loc.I}}" Style="{StaticResource FaintText}"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- Гистограмма длительностей (логарифмическая высота) -->
                            <ItemsControl ItemsSource="{Binding Histogram}" Margin="0,16,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LatencyBucketVm}">
                                        <StackPanel Margin="3,0">
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource FaintText}" FontSize="10" HorizontalAlignment="Center"/>
                                            <Grid Height="92">
                                                <Border Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="4,4,1,1" Background="{Binding Brush}" Opacity="0.85"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource FaintText}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ReportNote}" Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Драйверы -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding [lat.drivers], Source={x:Static i:Loc.I}}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding [lat.drivers.hint], Source={x:Static i:Loc.I}}" Style="{StaticResource MutedText}" Margin="0,4,0,12"/>
                    <ItemsControl ItemsSource="{Binding Drivers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LatencyDriverVm}">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                    <Border Grid.Column="1" Height="8" Width="240" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0"
                                            CornerRadius="4" Background="{StaticResource Track}">
                                        <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="4" Background="{Binding Brush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding MaxText}" FontWeight="SemiBold" Foreground="{Binding Brush}" Margin="0,1,0,0"/>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding About}" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,3,0,0"
                                                   Visibility="{Binding About, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Прерывания MSI -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding [lat.msi], Source={x:Static i:Loc.I}}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding [lat.msi.hint], Source={x:Static i:Loc.I}}" Style="{StaticResource MutedText}" Margin="0,4,0,12"/>
                    <TextBlock Text="{Binding DevicesNote}" Style="{StaticResource FaintText}" Margin="0,0,0,8"
                               Visibility="{Binding DevicesNote, Converter={StaticResource NullToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Devices}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InterruptVm}">
                                <Grid Margin="0,0,0,8" ToolTip="{Binding Technical}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource FaintText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Border Grid.Column="2" CornerRadius="10" Padding="10,2" BorderThickness="1" BorderBrush="{Binding Brush}">
                                        <TextBlock Text="{Binding Mode}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Brush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
