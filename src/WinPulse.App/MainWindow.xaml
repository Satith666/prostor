<Window x:Class="WinPulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinPulse.App.ViewModels"
        xmlns:v="clr-namespace:WinPulse.App.Views"
        xmlns:i="clr-namespace:WinPulse.App.Infrastructure"
        Title="WinPulse" Width="1320" Height="860" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <v:OverviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CpuViewModel}">
            <v:CpuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
            <v:MemoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiskViewModel}">
            <v:DiskView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GpuViewModel}">
            <v:GpuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
            <v:NetworkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProblemsViewModel}">
            <v:ProblemsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FixModuleViewModel}">
            <v:FixModuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}">
            <v:DriversView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}">
            <v:StartupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}">
            <v:GamesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpscalersViewModel}">
            <v:UpscalersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LatencyViewModel}">
            <v:LatencyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <v:PlaceholderView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}" TextElement.Foreground="{StaticResource Text}"
          TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.FontSize="13">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Подсветка фона: циан слева сверху, фиолетовый справа снизу -->
        <Rectangle Grid.ColumnSpan="2" Fill="{StaticResource BgGlowCyan}" IsHitTestVisible="False"/>
        <Rectangle Grid.ColumnSpan="2" Fill="{StaticResource BgGlowViolet}" IsHitTestVisible="False"/>

        <!-- Боковое меню -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,16">
                    <!-- Логотип как у значка программы: тёмная плитка, «W» из линии пульса с подсветкой -->
                    <Grid Width="38" Height="38">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource AccentGradient}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#101A30" Offset="0"/>
                                    <GradientStop Color="#070B16" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Viewbox Width="30" Height="30" Effect="{StaticResource GlowCyan}">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3.8,12 H6.5 L8.4,7.2 L10.6,16.8 L12,10.1 L13.4,16.8 L15.6,7.2 L17.5,12 H20.2"
                                      Stroke="{StaticResource AccentGradient}" StrokeThickness="1.9"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinPulse" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding [app.tagline], Source={x:Static i:Loc.I}}" Style="{StaticResource FaintText}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Низ меню -->
                <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,0">
                    <Border Style="{StaticResource Chip}" Background="{StaticResource WarnBg}" HorizontalAlignment="Left" Margin="0,0,0,10"
                            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding [shell.demo.hint], Source={x:Static i:Loc.I}}">
                        <TextBlock Text="{Binding [shell.demo], Source={x:Static i:Loc.I}}" Foreground="{StaticResource Warn}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="12" Padding="12,10" Margin="0,0,0,12" Background="#1A8B5CF6" BorderBrush="#408B5CF6" BorderThickness="1">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ProMode, Mode=TwoWay}"
                                      ToolTip="{Binding [shell.pro.hint], Source={x:Static i:Loc.I}}">
                            <TextBlock Text="{Binding [shell.pro], Source={x:Static i:Loc.I}}" Foreground="{StaticResource Text}"/>
                        </ToggleButton>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding [shell.language], Source={x:Static i:Loc.I}}" Style="{StaticResource FaintText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="{StaticResource PanelAlt}" CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="lang" Content="RU" IsChecked="{Binding IsRussian, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="lang" Content="EN" IsChecked="{Binding English, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource FaintText}">
                        <Run Text="{Binding RightsText, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Padding="0,2" Margin="0,2,0,0"
                            Command="{Binding RestartAsAdminCommand}"
                            Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisInv}}">
                        <TextBlock Text="{i:L 'Перезапустить от администратора', 'Restart as administrator'}" FontSize="12"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource FaintText}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource BtnGhost}" Padding="8,0" Command="{Binding OpenLogCommand}">
                            <TextBlock Text="{Binding [shell.log], Source={x:Static i:Loc.I}}" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5"
                            Command="{Binding UpdateCommand}"
                            Visibility="{Binding UpdateText, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding UpdateText}" FontSize="12"/>
                    </Button>
                </StackPanel>

                <!-- Пункты меню -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Nav}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Section, Converter={StaticResource Upper}}" Style="{StaticResource Caption}" Margin="12,16,10,6"
                                               Visibility="{Binding Section, Converter={StaticResource NullToVis}}"/>
                                    <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="{Binding Icon}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Badge}" Foreground="{StaticResource Faint}" FontSize="11"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding Soon, Converter={StaticResource BoolToVisInv}}"/>
                                            <Border Grid.Column="1" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" Background="{StaticResource Warn}"
                                                    VerticalAlignment="Center" Effect="{StaticResource GlowWarn}"
                                                    Visibility="{Binding Alert, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{Binding Alert}" Foreground="#1A0B00" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource Chip}" Padding="6,0" Margin="8,0,0,0"
                                                    Visibility="{Binding Soon, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding [nav.soon], Source={x:Static i:Loc.I}}" FontSize="9"
                                                           Foreground="{StaticResource Faint}"/>
                                            </Border>
                                        </Grid>
                                    </RadioButton>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Страница -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>
    </Grid>
</Window>
