<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Палитра «Кокпит»: тёмно-синий фон, неоновый циан и фиолетовый, подсветка -->
    <Color x:Key="C.Bg">#060A13</Color>
    <Color x:Key="C.Accent">#22D3EE</Color>
    <Color x:Key="C.Accent2">#8B5CF6</Color>
    <Color x:Key="C.Violet">#A78BFA</Color>
    <Color x:Key="C.Good">#34D399</Color>
    <Color x:Key="C.Warn">#FB923C</Color>
    <Color x:Key="C.Bad">#F87171</Color>

    <SolidColorBrush x:Key="Bg" Color="#060A13"/>
    <SolidColorBrush x:Key="Sidebar" Color="#B8080D1A"/>
    <!-- Карточки: полупрозрачный градиент, чтобы сквозь них просвечивала подсветка фона -->
    <LinearGradientBrush x:Key="Panel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D117213A" Offset="0"/>
        <GradientStop Color="#D10B1120" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelSolid" Color="#0F1729"/>
    <SolidColorBrush x:Key="PanelAlt" Color="#16213A"/>
    <SolidColorBrush x:Key="Hover" Color="#1C2948"/>
    <SolidColorBrush x:Key="Line" Color="#22304F"/>
    <SolidColorBrush x:Key="LineBright" Color="#33466F"/>
    <SolidColorBrush x:Key="Text" Color="#E6EDF7"/>
    <SolidColorBrush x:Key="Muted" Color="#AAB8D0"/>
    <SolidColorBrush x:Key="Faint" Color="#8191AF"/>
    <SolidColorBrush x:Key="Accent" Color="#22D3EE"/>
    <SolidColorBrush x:Key="Accent2" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Violet" Color="#A78BFA"/>
    <SolidColorBrush x:Key="AccentBg" Color="#1A22D3EE"/>
    <SolidColorBrush x:Key="Warn" Color="#FB923C"/>
    <SolidColorBrush x:Key="WarnBg" Color="#24FB923C"/>
    <SolidColorBrush x:Key="Bad" Color="#F87171"/>
    <SolidColorBrush x:Key="BadBg" Color="#24F87171"/>
    <SolidColorBrush x:Key="Good" Color="#34D399"/>
    <SolidColorBrush x:Key="GoodBg" Color="#2034D399"/>
    <SolidColorBrush x:Key="Yellow" Color="#FACC15"/>

    <!-- Градиенты акцента -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4722D3EE" Offset="0"/>
        <GradientStop Color="#478B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3322D3EE" Offset="0"/>
        <GradientStop Color="#0A22D3EE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FeatureCard" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#388B5CF6" Offset="0"/>
        <GradientStop Color="#1A22D3EE" Offset="1"/>
    </LinearGradientBrush>

    <!-- Подсветка фона окна -->
    <RadialGradientBrush x:Key="BgGlowCyan" Center="0.06,-0.05" GradientOrigin="0.06,-0.05" RadiusX="0.55" RadiusY="0.7">
        <GradientStop Color="#2E22D3EE" Offset="0"/>
        <GradientStop Color="#0022D3EE" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BgGlowViolet" Center="1.02,1.08" GradientOrigin="1.02,1.08" RadiusX="0.6" RadiusY="0.75">
        <GradientStop Color="#388B5CF6" Offset="0"/>
        <GradientStop Color="#008B5CF6" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>
