{"source":"prostor",
"rules": [
{"id":"user_temp","cat":"system","name":"Временные файлы пользователя","desc":"Папка %TEMP%: остатки установщиков, распаковок и программ. Свежие файлы пропускаются.","default":true,"locs":[{"path":"%TEMP%"},{"path":"%LOCALAPPDATA%\\Temp"}],"recent":true},
{"id":"win_temp","cat":"system","name":"Временные файлы Windows","desc":"C:\\Windows\\Temp — временные файлы служб и установщиков.","admin":true,"default":true,"locs":[{"path":"%SystemRoot%\\Temp"}],"recent":true},
{"id":"wu_cache","cat":"system","name":"Кэш Центра обновления Windows","desc":"Уже установленные пакеты обновлений. Служба обновления будет перезапущена.","admin":true,"default":true,"locs":[{"path":"%SystemRoot%\\SoftwareDistribution\\Download"}],"special":"services:wuauserv"},
{"id":"delivery_opt","cat":"system","name":"Кэш оптимизации доставки","desc":"Файлы обновлений, которыми Windows делится с другими ПК.","admin":true,"default":true,"locs":[{"path":"%SystemRoot%\\ServiceProfiles\\NetworkService\\AppData\\Local\\Microsoft\\Windows\\DeliveryOptimization\\Cache"},{"path":"%SystemRoot%\\SoftwareDistribution\\DeliveryOptimization"}],"special":"services:DoSvc"},
{"id":"wer","cat":"system","name":"Отчёты об ошибках Windows","desc":"Архив и очередь отчётов о сбоях программ (WER).","default":true,"locs":[{"path":"%ProgramData%\\Microsoft\\Windows\\WER\\ReportArchive"},{"path":"%ProgramData%\\Microsoft\\Windows\\WER\\ReportQueue"},{"path":"%ProgramData%\\Microsoft\\Windows\\WER\\Temp"},{"path":"%LOCALAPPDATA%\\Microsoft\\Windows\\WER"}]},
{"id":"sys_dumps","cat":"system","name":"Дампы памяти системы","desc":"MEMORY.DMP, минидампы и отчёты ядра после «синих экранов». Могут занимать гигабайты.","admin":true,"default":true,"locs":[{"path":"%SystemRoot%\\MEMORY.DMP"},{"path":"%SystemRoot%\\Minidump"},{"path":"%SystemRoot%\\LiveKernelReports"}]},
{"id":"app_dumps","cat":"system","name":"Дампы падений программ","desc":"Файлы .dmp, которые программы оставляют при аварийном завершении.","default":true,"locs":[{"path":"%LOCALAPPDATA%\\CrashDumps"}]},
{"id":"win_logs","cat":"system","name":"Журналы Windows и установки","desc":"Файлы журналов (.log, .etl, .cab) старше 7 дней из Windows\\Logs и Panther.","admin":true,"default":true,"locs":[{"path":"%SystemRoot%\\Logs","masks":["*.log","*.etl","*.cab","*.old","*.lo_","*.txt","*.xml"],"keepDirs":true},{"path":"%SystemRoot%\\Panther","masks":["*.log","*.etl","*.cab","*.old","*.lo_","*.txt","*.xml"],"keepDirs":true},{"path":"%SystemRoot%\\debug","masks":["*.log","*.etl","*.cab","*.old","*.lo_","*.txt","*.xml"],"keepDirs":true},{"path":"%SystemRoot%\\System32\\LogFiles\\setupcln","masks":["*.log","*.etl","*.cab","*.old","*.lo_","*.txt","*.xml"],"keepDirs":true}],"minAge":7},
{"id":"thumbcache","cat":"system","name":"Кэш эскизов и значков","desc":"Миниатюры Проводника. Пересоздаются автоматически; занятые файлы пропускаются.","default":true,"locs":[{"path":"%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer","masks":["thumbcache_*.db","iconcache_*.db"],"flat":true}]},
